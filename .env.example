# Press Start — environment
#
# Copy to `.env.local` and fill in. Nothing here is secret in the example;
# `.env.local` is gitignored and must never be committed.
#
# Phase 0 needs none of these. They are listed now so a new environment can be
# stood up from one file rather than from memory.

# --- Application ------------------------------------------------------------

# Absolute origin of this deployment, no trailing slash. Used to build magic
# link redirects, so it must match the origin the user actually browses.
# Local: http://localhost:3000
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# --- Supabase ---------------------------------------------------------------
# `supabase start` prints all three for local development.

# Project REST endpoint. Public: it ships in the browser bundle.
NEXT_PUBLIC_SUPABASE_URL=

# Anonymous key. Public by design — row-level security, not this key, is what
# protects the data. If a policy is wrong, this key is not the reason.
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Service role key. Bypasses row-level security entirely. Server-only: never
# prefix it with NEXT_PUBLIC_, never import it into a client component.
# Used for closing votes and broadcasting aggregate tallies.
SUPABASE_SERVICE_ROLE_KEY=

# Direct Postgres connection, used by the migration and RLS test suites.
# Local default: postgresql://postgres:postgres@127.0.0.1:54322/postgres
SUPABASE_DB_URL=

# --- Testing ----------------------------------------------------------------

# Origin Playwright tests run against. Unset locally: the config starts its own
# server on PORT. Set in CI when testing a deployed preview.
# PLAYWRIGHT_BASE_URL=
