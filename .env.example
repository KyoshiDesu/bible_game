# Press Start — environment
#
# Copy to `.env` (or `.env.local`) and fill in. Nothing here is secret in the
# example; the filled-in copy is gitignored and must never be committed.

# --- Application ------------------------------------------------------------

# Absolute origin of this deployment, no trailing slash. Used to build magic
# link redirects, so it must match the origin the user actually browses.
# Local: http://localhost:3000
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# --- Supabase ---------------------------------------------------------------
# Project settings → API keys. `supabase start` prints local equivalents.

# Project REST endpoint. Public: it ships in the browser bundle.
NEXT_PUBLIC_SUPABASE_URL=

# Publishable key (`sb_publishable_…`; the anon key on older projects).
# Public by design — row-level security, not this key, is what protects the
# data. If a policy is wrong, this key is not the reason.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Secret key (`sb_secret_…`; the service_role key on older projects). Bypasses
# row-level security entirely. Server-only: never prefix it with NEXT_PUBLIC_,
# never import it into a client component. Used for closing votes and
# broadcasting aggregate tallies.
SUPABASE_SECRET_KEY=

# Direct Postgres connection, used by the migration and RLS test suites.
# Local default: postgresql://postgres:postgres@127.0.0.1:54322/postgres
SUPABASE_DB_URL=

# --- Testing ----------------------------------------------------------------

# Origin Playwright tests run against. Unset locally: the config starts its own
# server on PORT. Set in CI when testing a deployed preview.
# PLAYWRIGHT_BASE_URL=
